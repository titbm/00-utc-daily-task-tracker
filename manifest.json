{
  "manifest_version": 3,
  "name": "00 UTC | Daily Task Tracker",
  "version": "1.0.0",
  "description": "Track and manage your daily internet tasks with automatic restoration at midnight UTC. Organize web pages you need to visit daily with bookmark-based storage.",
  "author": "Your Name",
  
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "sidePanel",
    "bookmarks",
    "alarms",
    "storage"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["src/sidepanel/intervalDialog.html", "src/sidepanel/completed.html", "src/shared/roughNotation.js"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_title": "Open 00 UTC | Daily Task Tracker popup window",
    "default_popup": "src/popup/popup.html"
  },
  
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}

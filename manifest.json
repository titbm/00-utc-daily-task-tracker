{
  "manifest_version": 3,
  "name": "Daily Panel",
  "version": "1.0",
  "description": "Боковая панель для управления вкладками",
  
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "sidePanel",
    "bookmarks",
    "alarms"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-banner.js"],
      "run_at": "document_end"
    }
  ],
  
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["interval-dialog.html", "completed.html"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_title": "Открыть Daily Panel"
  },
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

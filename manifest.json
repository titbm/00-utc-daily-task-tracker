{
  "manifest_version": 3,
  "name": "00 UTC | Daily Task Tracker",
  "version": "1.0",
  "description": "Task tracker for internet daily tasks",
  
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "sidePanel",
    "bookmarks",
    "alarms",
    "storage"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-banner.js"],
      "run_at": "document_idle"
    }
  ],
  
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["interval-dialog.html", "completed.html", "rough-notation.iife.js"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_title": "Open 00 UTC | Daily Task Tracker popup window",
    "default_popup": "popup.html"
  },
  
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

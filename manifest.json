{
  "manifest_version": 3,
  "name": "Daily Panel",
  "version": "1.0",
  "description": "Боковая панель для управления вкладками",
  
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  
  "action": {
    "default_title": "Открыть Daily Panel"
  },
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

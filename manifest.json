{
  "manifest_version": 3,
  "name": "00 UTC | Daily Task Tracker",
  "version": "1.0.8",
  "description": "Daily task tracker with auto-restoration, side panel UI, and task cycles. Bookmark storage. Works offline. No database needed.",
  "author": "titbmm",
  
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "sidePanel",
    "bookmarks",
    "alarms",
    "storage",
    "management",
    "downloads"
  ],
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/intervalDialog.html", 
        "src/pages/completed.html", 
        "src/shared/roughNotation.js",
        "assets/icons/local_fire_department-cropped.svg",
        "assets/icons/check.svg",
        "assets/icons/bedtime.svg",
        "assets/icons/schedule.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_title": "Open 00 UTC | Daily Task Tracker popup window",
    "default_popup": "src/popup/popup.html"
  },
  
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
